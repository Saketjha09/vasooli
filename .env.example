# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed — this file (.env.example) is the safe, shareable version.

# Supabase Postgres connection string
DATABASE_URL=

# Vercel frontend URL, for backend CORS
ALLOWED_ORIGIN=

# Server port (Railway sets this automatically in production)
PORT=8080

# Path to the fixed synthetic demo dataset fixture
DEMO_SEED_PATH=backend/fixtures/demo_dataset.json
